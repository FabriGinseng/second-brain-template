{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/stop_verify.py",
            "timeout": 120
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Edit(/daily/**)",
      "Edit(/radar/**)",
      "Edit(/inbox/**)",
      "Edit(/projects/**)",
      "Edit(/content/**)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git log *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git show *)",
      "Bash(./scripts/verify *)",
      "Bash(python3 scripts/verify *)",
      "Bash(python scripts/verify *)",
      "Bash(py -3 scripts/verify *)",
      "Bash(python3 -I scripts/attivita-progetti.py *)",
      "Bash(py -3 -I scripts/attivita-progetti.py *)"
    ],
    "deny": [
      "Read(/projects/_private/**)",
      "Edit(/projects/_private/**)",
      "Bash(*_private*)"
    ],
    "ask": [
      "Edit(/CLAUDE.md)",
      "Edit(/memory/**)",
      "Edit(/docs/adr/**)",
      "Edit(/.claude/**)"
    ],
    "disableBypassPermissionsMode": "disable"
  }
}
