{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/protect_files.py",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/no_bypass.py",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/stop_verify.py",
            "timeout": 120
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Edit(/daily/**)",
      "Edit(/radar/**)",
      "Edit(/inbox/**)",
      "Edit(/projects/**)",
      "Edit(/content/**)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git log *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git show *)",
      "Bash(./scripts/verify *)",
      "Bash(python3 scripts/verify *)",
      "Bash(python scripts/verify *)",
      "Bash(py -3 scripts/verify *)",
      "Bash(python3 -I scripts/attivita-progetti.py *)",
      "Bash(py -3 -I scripts/attivita-progetti.py *)"
    ],
    "deny": [
      "Bash(git reset --hard *)",
      "Bash(git rebase *)",
      "Bash(git filter-branch *)",
      "Bash(git commit --amend *)",
      "Bash(git commit *--no-verify*)",
      "Bash(git commit -n*)",
      "Bash(git clean *)",
      "Read(/projects/_private/**)",
      "Edit(/projects/_private/**)",
      "Bash(*_private*)",
      "Bash(git push *--force*)",
      "Bash(git push -f*)",
      "Bash(git push * -f*)"
    ],
    "ask": [
      "Edit(/CLAUDE.md)",
      "Edit(/memory/**)",
      "Edit(/docs/adr/**)",
      "Edit(/.claude/**)",
      "Bash(git push *)",
      "Bash(rm *)",
      "Bash(launchctl *)",
      "Bash(gh pr create *)",
      "Bash(gh pr merge *)",
      "Bash(gh repo *)",
      "Bash(gh release *)",
      "Bash(npm publish*)",
      "Bash(vercel *)",
      "Bash(netlify *)",
      "Bash(fly *)",
      "Bash(kubectl *)",
      "Bash(docker push *)",
      "Bash(ssh *)"
    ],
    "disableBypassPermissionsMode": "disable"
  }
}
