{
  "morning": {
    "description": "morning start: closes pending work, creates today's daily note, opens the dashboard",
    "command": [
      "{python}",
      "-I",
      "{vault}/scripts/avvio.py"
    ],
    "days": [
      1,
      2,
      3,
      4,
      5
    ],
    "time": "08:00",
    "at_login": true,
    "os": [
      "macos",
      "windows"
    ]
  },
  "chiusura": {
    "log": "chiudi",
    "description": "/chiudi-giornata: rewrites the STATE files from your commits and commits locally",
    "command": [
      "{python}",
      "-I",
      "{vault}/scripts/chiudi-giornata.py"
    ],
    "days": [
      1,
      2,
      3,
      4,
      5
    ],
    "time": "18:30"
  },
  "feed": {
    "description": "collects the news from the feeds in memory/feeds.md into inbox/ (built-in collector, no n8n)",
    "command": [
      "{python}",
      "-I",
      "{vault}/scripts/feed.py"
    ],
    "days": [
      1
    ],
    "time": "07:00",
    "default": false,
    "modulo": "radar",
    "se": {
      "automazione": "interno"
    }
  },
  "radar": {
    "description": "filters the news in inbox/ for your projects (the models you chose in setup.py)",
    "command": [
      "{python}",
      "-I",
      "{vault}/scripts/radar.py"
    ],
    "days": [
      1
    ],
    "time": "07:30",
    "default": false,
    "modulo": "radar"
  },
  "bozze": {
    "description": "/bozze-settimana: three post drafts (needs Claude Code)",
    "command": [
      "{python}",
      "-I",
      "{vault}/scripts/prepara-bozze.py"
    ],
    "days": [
      1
    ],
    "time": "08:30",
    "default": false,
    "modulo": "bozze"
  },
  "pulizia": {
    "description": "weekly check: versions, usage report, skill check, log rotation",
    "command": [
      "{python}",
      "-I",
      "{vault}/scripts/pulizia-settimanale.py"
    ],
    "days": [
      5
    ],
    "time": "18:00"
  },
  "dashboard": {
    "description": "keeps the local dashboard running on 127.0.0.1:8765",
    "command": [
      "{python}",
      "-I",
      "{vault}/scripts/dashboard/server.py"
    ],
    "service": true
  },
  "tray": {
    "description": "tray icon (Windows) or menu-bar icon (macOS): dashboard status, quick job starts, failure notifications",
    "command": [
      "powershell.exe",
      "-NoProfile",
      "-NonInteractive",
      "-ExecutionPolicy",
      "Bypass",
      "-WindowStyle",
      "Hidden",
      "-File",
      "{vault}/scripts/tray/tray.ps1"
    ],
    "command_by_os": {
      "macos": [
        "{home}/Library/Application Support/second-brain/SecondBrainTray"
      ]
    },
    "build": {
      "macos": [
        [
          "mkdir",
          "-p",
          "{home}/Library/Application Support/second-brain"
        ],
        [
          "swiftc",
          "-O",
          "-swift-version",
          "5",
          "-o",
          "{home}/Library/Application Support/second-brain/SecondBrainTray",
          "{vault}/scripts/tray/SecondBrainTray.swift"
        ]
      ]
    },
    "at_login": true,
    "long_running": true,
    "os": [
      "macos",
      "windows"
    ]
  }
}
