#!/usr/bin/env python3
"""Controlla le regole del vault: STATE corti, INDEX coerente, wikilink validi, registro dei template.

Uso: scripts/verify [RADICE_VAULT]
Exit 0 se tutto passa, 1 se trova problemi. Stampa "file: problema" per ogni problema.
Nessun modello, solo lettura dei file.
"""
import datetime
import json
import pathlib
import re
import subprocess
import sys

MAX_STATE_LINES = 20  # righe non vuote
PRIVATE_DIRS = {'lavoro', '_private'}  # cartelle riservate: non devono stare in INDEX
SKIP_DIRS = {'.git', '.obsidian', '.claude', '.superpowers', 'templates', 'template', 'node_modules'}  # template/: il vault di esempio, ha il suo verify
# Link Obsidian; il pipe può essere escapato come \| dentro le tabelle.
WIKILINK = re.compile(r'\[\[((?:\\\||[^\]])+)\]\]')
INDEX_ROW_START = re.compile(r'^\|\s*\[\[((?:\\\||[^\]])+)\]\]')
INDEX_DATE_END = re.compile(r'(\d{4}-\d{2}-\d{2})\s*\|\s*$')
CODE_SPAN = re.compile(r'`[^`]*`')
UPDATED = re.compile(r'\*\*Aggiornato:\*\*\s*(\d{4}-\d{2}-\d{2})')
TIPI = {'frontend', 'backend', 'fullstack', 'altro'}  # colonna "tipo" di scaffold/registro.md
PROFILI = {'personal', 'lavoro'}
GH_ORIGINE = re.compile(r'gh:[\w.-]+/[\w.-]+')


def read(path):
    # errors='replace': un file non UTF-8 non deve far fallire il controllo.
    return path.read_text(encoding='utf-8', errors='replace')


def headings(path):
    return [line[3:].strip() for line in read(path).splitlines() if line.startswith('## ')]


def normalize(target):
    # [[projects/x/STATE\\|alias#sezione]] -> projects/x/STATE
    return target.replace('\\|', '|').split('|')[0].split('#')[0].strip()


def project_of(target):
    parts = normalize(target).split('/')
    return parts[1] if parts[0] == 'projects' and len(parts) > 1 else parts[0]


def is_skipped(path, root):
    return any(part in SKIP_DIRS for part in path.relative_to(root).parts)


def check_projects(root, problems):
    template = root / 'templates' / 'STATE.md'
    required = headings(template) if template.exists() else []

    index = root / 'projects' / 'INDEX.md'
    rows = {}
    if not index.exists():
        problems.append('projects/INDEX.md: manca')
    else:
        for number, line in enumerate(read(index).splitlines(), 1):
            start = INDEX_ROW_START.match(line)
            if not start:
                continue
            name = project_of(start.group(1))
            date = INDEX_DATE_END.search(line)
            if not date:
                problems.append(f'projects/INDEX.md:{number}: riga "{name}" senza data')
                rows[name] = None
            else:
                rows[name] = date.group(1)

    projects_dir = root / 'projects'
    private_dirs = set(PRIVATE_DIRS)
    try:  # la cartella riservata scelta al setup (moduli.riservata.cartella), se sta dentro projects/
        scelta = json.loads((root / 'config.json').read_text(encoding='utf-8'))['moduli']['riservata']['cartella']
        if scelta.replace('\\', '/').startswith('projects/') and scelta.count('/') == 1:
            private_dirs.add(scelta.split('/')[1])
    except (OSError, ValueError, KeyError, TypeError, AttributeError):
        pass
    folders = []
    if projects_dir.exists():
        folders = sorted(p.name for p in projects_dir.iterdir()
                         if p.is_dir() and not p.name.startswith('.') and p.name not in private_dirs)

    for name in rows:
        if not (projects_dir / name).is_dir():
            problems.append(f'projects/INDEX.md: riga "{name}" senza cartella')
    for name in folders:
        if name not in rows:
            problems.append(f'projects/{name}: cartella non presente in INDEX.md')
        state = projects_dir / name / 'STATE.md'
        rel = f'projects/{name}/STATE.md'
        if not state.exists():
            problems.append(f'{rel}: manca')
            continue
        text = read(state)
        lines = len([line for line in text.splitlines() if line.strip()])
        if lines > MAX_STATE_LINES:
            problems.append(f'{rel}: {lines} righe non vuote, massimo {MAX_STATE_LINES}')
        present = headings(state)
        for heading in required:
            if heading not in present:
                problems.append(f'{rel}: manca la sezione "{heading}"')
        updated = UPDATED.search(text)
        if not updated:
            problems.append(f'{rel}: manca "Aggiornato"')
        elif rows.get(name) and updated.group(1) != rows[name]:
            problems.append(f'{rel}: Aggiornato {updated.group(1)} diverso da INDEX ({rows[name]})')


def check_wikilinks(root, problems):
    # Obsidian risolve per nome di file, senza distinguere maiuscole.
    known = set()
    for p in root.rglob('*'):
        if p.is_file() and not is_skipped(p, root):
            known.add(p.name.lower())
            known.add(p.stem.lower())
            if p.suffix == '.md':
                known.add(p.relative_to(root).with_suffix('').as_posix().lower())
    for path in root.rglob('*.md'):
        if is_skipped(path, root):
            continue
        in_fence = False
        for number, line in enumerate(read(path).splitlines(), 1):
            if line.strip().startswith('```'):
                in_fence = not in_fence
                continue
            if in_fence:
                continue
            # Il testo tra backtick è un esempio, non un link.
            for raw in WIKILINK.findall(CODE_SPAN.sub('', line)):
                target = normalize(raw)
                if target.lower() not in known:
                    rel = path.relative_to(root)
                    problems.append(f'{rel}:{number}: wikilink rotto [[{target}]]')


def check_readme(root, problems):
    """Il README deve citare ogni job launchd (second-brain.<nome>, da scripts/jobs.json) e ogni comando di .claude/commands (/<nome>).

    Si controlla solo se esistono il README e la cartella dei job: un vault senza questi file non è obbligato ad averli.
    """
    readme = root / 'README.md'
    jobs = root / 'scripts' / 'jobs.json'
    if not readme.is_file() or not jobs.is_file():
        return
    testo = read(readme)
    for nome in sorted(json.loads(read(jobs))):
        if f'second-brain.{nome}' not in testo:
            problems.append(f'README.md: non cita il job launchd {nome}')
    commands = root / '.claude' / 'commands'
    for comando in sorted(commands.glob('*.md')) if commands.is_dir() else []:
        if f'/{comando.stem}' not in testo:
            problems.append(f'README.md: non cita il comando /{comando.stem}')


SCRIPT_CITATO = re.compile(r'`((?:scripts/)?[\w.-]+(?:/[\w.-]+)*\.(?:sh|py))`|`(scripts/[\w.-]+(?:/[\w.-]+)*)`')


def check_riferimenti_script(root, problems):
    """CLAUDE.md non deve citare uno script che non esiste: `scripts/x` esiste come percorso, `x.py` o `x.sh` esiste sotto scripts/.

    I pattern con * o <> (scripts/test_*.py) non sono percorsi e si saltano. Senza CLAUDE.md o senza cartella scripts/ non c'è nulla da controllare.
    """
    claude, scripts = root / 'CLAUDE.md', root / 'scripts'
    if not claude.is_file() or not scripts.is_dir():
        return
    visti = set()
    for m in SCRIPT_CITATO.finditer(read(claude)):
        voce = m.group(1) or m.group(2)
        if voce in visti:
            continue
        visti.add(voce)
        esiste = (root / voce).exists() if voce.startswith('scripts/') else any(scripts.rglob(voce))
        if not esiste:
            problems.append(f'CLAUDE.md: {voce} non esiste')


ADR_CITATO = re.compile(r'ADR-\d{3}')
ADR_FILE = re.compile(r'^ADR-\d{3}')
# Il prodotto, non specifiche, report o test: i file alla radice, le cartelle elencate e gli script .py alla radice (setup.py, install_jobs.py)
ADR_FILE_RADICE = ('README.md', 'README.it.md', 'CLAUDE.md', 'GLOSSARY.md', 'SECURITY.md', 'INIZIA.md', 'GETTING_STARTED.md', 'CHANGELOG.md')
ADR_CARTELLE = ('scripts', '.claude', 'docs/adr', 'templates')


def _file_del_prodotto(root):
    """Percorsi relativi (con /) da controllare. In un repo git solo i file tracciati: un worktree di un agente, un ramo o una skill di altri,
    ignorati da git, non devono bloccare verify (e con lui il commit della chiusura). Senza git, tutto tranne i worktree."""
    r = subprocess.run(['git', '-C', str(root), '-c', 'core.quotePath=false', 'ls-files', '-z'], capture_output=True)
    if r.returncode == 0 and (root / '.git').exists():
        candidati = [f for f in r.stdout.decode('utf-8', 'replace').split('\0') if f]
    else:
        candidati = [f.relative_to(root).as_posix() for f in root.rglob('*') if f.is_file()]
    for f in candidati:
        parti = f.split('/')
        if parti[-1].startswith('test_') or '__pycache__' in parti or 'worktrees' in parti or f.rsplit('.', 1)[-1] in ('pyc', 'png', 'jpg'):
            continue
        if f in ADR_FILE_RADICE or (len(parti) == 1 and f.endswith('.py')) or any(f.startswith(c + '/') for c in ADR_CARTELLE):
            yield f


def check_adr_citati(root, problems):
    """Ogni ADR-NNN citato nel prodotto deve avere un file in docs/adr/. Senza docs/adr/ non c'è niente da controllare.

    Nel template pubblico citava ADR-001 e ADR-005, che lì non c'erano: riferimenti vuoti per chi lo usa.
    """
    cartella = root / 'docs' / 'adr'
    if not cartella.is_dir():
        return
    esistenti = {m.group(0) for f in cartella.glob('ADR-*.md') if (m := ADR_FILE.match(f.name))}
    for rel in _file_del_prodotto(root):
        visti = set()
        for m in ADR_CITATO.finditer(read(root / rel)):
            if m.group(0) not in esistenti and m.group(0) not in visti:
                visti.add(m.group(0))
                problems.append(f'{rel}: {m.group(0)} non esiste')


def check_scaffold(root, problems):
    """Se esiste scaffold/registro.md ne controlla le righe e i file dei profili.

    Le colonne e i valori ammessi sono quelli di docs/specs/2026-11-03-nuovo-repo-design.md. I repo gh: non si
    controllano (serve la rete); i percorsi locale: sì.
    """
    registro = root / 'scaffold' / 'registro.md'
    if not registro.is_file():
        return
    for nome in sorted(PROFILI):
        if not (root / 'scaffold' / 'profili' / f'{nome}.md').is_file():
            problems.append(f'scaffold/profili/{nome}.md: manca')
    visti = set()
    for number, line in enumerate(read(registro).splitlines(), 1):
        if not line.startswith('|'):
            continue
        celle = [c.strip() for c in line.strip().strip('|').split('|')]
        if celle[0] in ('Nome', '') or set(celle[0]) <= set('-: '):
            continue  # intestazione e separatore
        where = f'scaffold/registro.md:{number}'
        if len(celle) != 6:
            problems.append(f'{where}: {len(celle)} colonne, servono 6')
            continue
        nome, tipo, _tecnologia, profilo, origine, data = celle
        if nome in visti:
            problems.append(f'{where}: nome "{nome}" duplicato')
        visti.add(nome)
        if tipo not in TIPI:
            problems.append(f'{where}: tipo "{tipo}" non ammesso ({", ".join(sorted(TIPI))})')
        if profilo not in PROFILI:
            problems.append(f'{where}: profilo "{profilo}" non ammesso ({", ".join(sorted(PROFILI))})')
        try:
            datetime.date.fromisoformat(data)
        except ValueError:
            problems.append(f'{where}: data "{data}" non valida (AAAA-MM-GG)')
        if origine.startswith('locale:'):
            percorso = pathlib.Path(origine[len('locale:'):].strip()).expanduser()
            if not percorso.is_dir():
                problems.append(f'{where}: il percorso "{percorso}" non esiste')
        elif GH_ORIGINE.fullmatch(origine):
            if profilo == 'lavoro':
                problems.append(f'{where}: un template di lavoro ha solo origine locale:')
        else:
            problems.append(f'{where}: origine "{origine}" non riconosciuta (gh:proprietario/repo o locale:percorso)')


def main(argv):
    root = pathlib.Path(argv[1]) if len(argv) > 1 else pathlib.Path(__file__).resolve().parent.parent
    problems = []
    check_projects(root, problems)
    check_wikilinks(root, problems)
    check_readme(root, problems)
    check_riferimenti_script(root, problems)
    check_adr_citati(root, problems)
    check_scaffold(root, problems)
    for problem in problems:
        print(problem)
    if problems:
        return 1
    print('OK')
    return 0


if __name__ == '__main__':
    sys.exit(main(sys.argv))
